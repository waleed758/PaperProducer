DJANGO_DEBUG=true
DJANGO_SECRET_KEY=replace-this-with-a-random-local-development-key
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Keep sqlite for the initial scaffold. Set DB_ENGINE=postgresql and provide
# the values below when the local PostgreSQL service and role are ready.
DB_ENGINE=sqlite
